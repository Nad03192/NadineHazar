@model WebApplication8.Models.Class
@{
    ViewData["Title"] = "Create Class";
}

<h1>Create Class</h1>

<form asp-action="Create" method="post" id="createClassForm">
    <div class="form-group">
        <label asp-for="CourseId"></label>
        <select asp-for="CourseId" class="form-control" id="courseSelect">
            <option value="">-- Select Course --</option>
            @foreach (var course in (SelectList)ViewData["CourseId"])
            {
                <option value="@course.Value">@course.Text</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label asp-for="StartTime"></label>
        <input asp-for="StartTime" class="form-control" type="time" id="startTimeInput" />
    </div>

    <div class="form-group">
        <label asp-for="DayOfWeek"></label>
        <select asp-for="DayOfWeek" class="form-control" id="dayOfWeekSelect">
            <option value="">-- Select Day --</option>
            @foreach (var day in Enum.GetValues(typeof(DayOfWeek)).Cast<DayOfWeek>())
            {
                <option value="@day">@day</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label asp-for="UserId">Instructor</label>
        <select asp-for="UserId" class="form-control" id="instructorSelect">
            <option value="">-- Select Instructor --</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="RoomId">Room</label>
        <select asp-for="RoomId" class="form-control" id="roomSelect">
            <option value="">-- Select Room --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
</form>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        var getInstructorsUrl = '@Url.Action("GetEligibleInstructors", "Classes")';
        var getRoomsUrl = '@Url.Action("GetAvailableRooms", "Classes")';

        function loadInstructors() {
            var courseId = $('#courseSelect').val();
            var startTime = $('#startTimeInput').val();
            var dayOfWeek = $('#dayOfWeekSelect').val();

            if (courseId && startTime && dayOfWeek) {
                $.ajax({
                    url: getInstructorsUrl,
                    type: 'GET',
                    data: { courseId: courseId, newStartTime: startTime, dayOfWeek: dayOfWeek },
                    success: function (data) {
                        var instructorSelect = $('#instructorSelect');
                        instructorSelect.empty();
                        instructorSelect.append($('<option>').val('').text('-- Select Instructor --'));

                        if (data.length === 0) {
                            instructorSelect.append($('<option>').val('').text('No eligible instructors available'));
                            $('#roomSelect').empty().append($('<option>').val('').text('-- Select Room --'));
                        } else {
                            $.each(data, function (i, instructor) {
                                instructorSelect.append($('<option>').val(instructor.value).text(instructor.text));
                            });
                        }
                    },
                    error: function () {
                        alert('Error loading instructors.');
                    }
                });
            } else {
                $('#instructorSelect').empty().append($('<option>').val('').text('-- Select Instructor --'));
                $('#roomSelect').empty().append($('<option>').val('').text('-- Select Room --'));
            }
        }

        function loadRooms() {
            var courseId = $('#courseSelect').val();
            var startTime = $('#startTimeInput').val();
            var dayOfWeek = $('#dayOfWeekSelect').val();
            var userId = $('#instructorSelect').val();

            if (courseId && startTime && dayOfWeek && userId) {
                $.ajax({
                    url: getRoomsUrl,
                    type: 'GET',
                    data: { courseId: courseId, newStartTime: startTime, dayOfWeekStr: dayOfWeek, userId: userId },
                    success: function (data) {
                        var roomSelect = $('#roomSelect');
                        roomSelect.empty();
                        roomSelect.append($('<option>').val('').text('-- Select Room --'));

                        if (data.length === 0) {
                            roomSelect.append($('<option>').val('').text('No rooms available'));
                        } else {
                            $.each(data, function (i, room) {
                                roomSelect.append($('<option>').val(room.value).text(room.text));
                            });
                        }
                    },
                    error: function () {
                        alert('Error loading rooms.');
                    }
                });
            } else {
                $('#roomSelect').empty().append($('<option>').val('').text('-- Select Room --'));
            }
        }

        $(document).ready(function () {
            $('#courseSelect, #startTimeInput, #dayOfWeekSelect').on('change', function() {
                loadInstructors();
                $('#roomSelect').empty().append($('<option>').val('').text('-- Select Room --'));
            });

            $('#instructorSelect').on('change', loadRooms);
        });
    </script>
}
