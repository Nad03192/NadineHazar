@model WebApplication8.Models.Class

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Class</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Instructor Dropdown -->
            <div class="form-group">
                <label asp-for="UserId" class="control-label">Instructor</label>
                <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId"></select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <!-- Course Dropdown -->
            <div class="form-group">
                <label asp-for="CourseId" class="control-label">Course</label>
                <select asp-for="CourseId" class="form-control" asp-items="ViewBag.CourseId"></select>
                <span asp-validation-for="CourseId" class="text-danger"></span>
            </div>

            <!-- Room Dropdown -->
            <div class="form-group">
                <label asp-for="RoomId" class="control-label">Room</label>
                <select asp-for="RoomId" class="form-control" asp-items="ViewBag.RoomId"></select>
                <span asp-validation-for="RoomId" class="text-danger"></span>
            </div>

            <!-- Start Time -->
            <div class="form-group">
                <label asp-for="StartTime" class="control-label">Start Time</label>
                <input asp-for="StartTime" class="form-control" type="time" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>

            <!-- Day of Week -->
            <div class="form-group">
                <label asp-for="DayOfWeek" class="control-label">Day</label>
                <select asp-for="DayOfWeek" class="form-control">
                    @foreach (var day in Enum.GetValues(typeof(DayOfWeek)))
                    {
                        <option value="@day">@day</option>
                    }
                </select>
                <span asp-validation-for="DayOfWeek" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ml-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function loadInstructors() {
            const courseId = $('#CourseId').val();
            const startTime = $('#StartTime').val();
            const dayOfWeek = $('#DayOfWeek').val();

            if (courseId && startTime && dayOfWeek !== "") {
                $.ajax({
                    url: '/Classes/GetEligibleInstructors',
                    data: {
                        courseId: courseId,
                        startTime: startTime,
                        dayOfWeek: dayOfWeek
                    },
                    success: function (data) {
                        const instructorSelect = $('#UserId');
                        instructorSelect.empty();

                        if (data.length === 0) {
                            instructorSelect.append('<option>No eligible instructors</option>');
                        } else {
                            instructorSelect.append('<option value="">Select Instructor</option>');
                            $.each(data, function (index, item) {
                                instructorSelect.append(`<option value="${item.value}">${item.text}</option>`);
                            });
                        }
                    }
                });
            }
        }

        $(document).ready(function () {
            $('#CourseId, #StartTime, #DayOfWeek').on('change', loadInstructors);
        });
    </script>
}
