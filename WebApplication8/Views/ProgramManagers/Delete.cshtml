@model WebApplication8.Models.ProgramManager

@{
    ViewData["Title"] = "Delete Program Manager";
}

<h1>@ViewData["Title"]</h1>

<h3>Are you sure you want to delete this program manager?</h3>

<div>
    <h4>Program Manager</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.User.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.User.Email)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StudyProgram.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StudyProgram.Name)
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" name="userId" value="@Model.UserId" />
        <input type="hidden" name="studyProgramId" value="@Model.StudyProgramId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>

</div>
