@model WebApplication8.Models.ProgramManager

@{
    ViewData["Title"] = "Program Manager Details";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Program Manager</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.User.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.User.Email)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StudyProgram.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StudyProgram.Name)
        </dd>
    </dl>
</div>

<div>
    @Html.ActionLink("Edit", "Edit", new { userId = Model.UserId, studyProgramId = Model.StudyProgramId }, new { @class = "btn btn-primary" }) |
    @Html.ActionLink("Delete", "Delete", new { userId = Model.UserId, studyProgramId = Model.StudyProgramId }, new { @class = "btn btn-danger" }) |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
