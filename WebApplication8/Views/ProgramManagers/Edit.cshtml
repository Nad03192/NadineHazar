@model WebApplication8.Models.ProgramManager

@{
    ViewData["Title"] = "Edit Program Manager";
}

<h1>@ViewData["Title"]</h1>

<h4>Program Manager</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="StudyProgramId" />

            <div class="form-group mb-3">
                <label asp-for="UserId" class="form-label">Instructor</label>
                <select asp-for="UserId" class="form-select"
                        asp-items="ViewBag.UserId"></select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StudyProgramId" class="form-label">Study Program</label>
                <select asp-for="StudyProgramId" class="form-select"
                        asp-items="ViewBag.StudyProgramId"></select>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
