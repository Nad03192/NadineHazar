@model IEnumerable<WebApplication8.Models.Semester>

@{
    ViewData["Title"] = "Index";
}

<h1>Semesters</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EnrollmentStart)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EnrollmentEnd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AddDropStart)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AddDropEnd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SubmitClassesEnd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SubmitGradesEnd)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EnrollmentStart)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EnrollmentEnd)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AddDropStart)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AddDropEnd)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SubmitClassesEnd)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SubmitGradesEnd)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.SemesterId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.SemesterId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.SemesterId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
