@model WebApplication8.Models.UserProgram

@{
    ViewData["Title"] = "Edit User Program";
}

<h1>@ViewData["Title"]</h1>

<h4>User Program</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <!-- Hidden fields to preserve original keys if needed -->
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="StudyProgramId" />

            <!-- Select User -->
            <div class="form-group mb-3">
                <label asp-for="UserId" class="form-label"></label>
                <select asp-for="UserId" class="form-control" asp-items="ViewBag.Users">
                    <option value="">-- Select Student --</option>
                </select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <!-- Select Study Program -->
            <div class="form-group mb-3">
                <label asp-for="StudyProgramId" class="form-label"></label>
                <select asp-for="StudyProgramId" class="form-control" asp-items="ViewBag.StudyPrograms">
                    <option value="">-- Select Study Program --</option>
                </select>
                <span asp-validation-for="StudyProgramId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
