@model IEnumerable<WebApplication8.Models.UserCampus>

@{
    ViewData["Title"] = "User Campus";
    var campusList = ViewBag.CampusList as SelectList;
    var roleList = ViewBag.RoleList as SelectList;
    string searchString = ViewBag.SearchString as string;
}

<h1>User Campus</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<!-- Filter Form -->
<form asp-action="Index" method="get" class="form-inline mb-3">
    <div class="form-group mr-2">
        <label class="mr-2">Campus:</label>
        <select name="campusId" asp-items="campusList" class="form-control">
            <option value="">-- All Campuses --</option>
        </select>
    </div>

    <div class="form-group mr-2">
        <label class="mr-2">Role:</label>
        <select name="role" asp-items="roleList" class="form-control">
            <option value="">-- All Roles --</option>
        </select>
    </div>

    <div class="form-group mr-2">
        <label class="mr-2">Search:</label>
        <input type="text" name="searchString" value="@searchString" class="form-control" placeholder="Email / Phone / Username" />
    </div>


    <button type="submit" class="btn btn-primary">Filter</button>
    <a asp-action="Index" class="btn btn-secondary ml-2">Reset</a>
</form>

<table class="table">
    <thead>
        <tr>
            <th>User (Email)</th>
            <th>Campus</th>
            <th>Roles</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var roles = ViewBag.UserRoles != null && ViewBag.UserRoles.ContainsKey(item.UserId)
            ? string.Join(", ", ViewBag.UserRoles[item.UserId])
            : "No Role";

            <tr>
                <td>@item.User.Email</td>
                <td>@item.Campus.Name</td>
                <td>@roles</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { userId = item.UserId, campusId = item.CampusId }) |
                    @Html.ActionLink("Details", "Details", new { userId = item.UserId, campusId = item.CampusId }) |
                    @Html.ActionLink("Delete", "Delete", new { userId = item.UserId, campusId = item.CampusId })
                </td>
            </tr>
        }
    </tbody>
</table>
