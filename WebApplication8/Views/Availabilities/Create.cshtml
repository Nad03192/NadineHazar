@model WebApplication8.Models.Availability

@{
    ViewData["Title"] = "Create";
}

<h1>Create Availability</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- User -->
            <select asp-for="UserId" class="form-control" id="userSelect" asp-items="ViewBag.Users">
                <option value="">-- Select User --</option>
            </select>

            <!-- Day -->
            <select asp-for="DayOfWeek" class="form-control" id="daySelect" asp-items="ViewBag.DayOfWeekList">
                <option value="">-- Select Day --</option>
            </select>

            <!-- Shift (AJAX loaded) -->
            <select asp-for="ShiftId" class="form-control" id="shiftSelect">
                <option value="">-- Select Shift --</option>
            </select>

            <div class="form-group mt-2">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
                 function loadShifts() {
            var userId = $("#userSelect").val();
            var dayOfWeek = $("#daySelect").val();
            dayOfWeek = dayOfWeek ? parseInt(dayOfWeek) : null;

            var $shiftSelect = $("#shiftSelect");
            $shiftSelect.empty().append($('<option>', { value: '', text: '-- Select Shift --' }));

            if (!userId) return;

            $.getJSON('@Url.Action("GetAvailableShifts", "Availabilities")',
                { userId: userId, dayOfWeek: dayOfWeek },
                function (data) {
                    console.log("Returned data:", data);

                    if (!data || data.length === 0) {
                        $shiftSelect.append($('<option>', { value: '', text: 'No shifts available' }));
                        return;
                    }

                    $.each(data, function (i, shift) {
                        $shiftSelect.append($('<option>', { value: shift.shiftId, text: shift.text }));
                    });
                }
            );
        }

        // Trigger on change
        $("#userSelect, #daySelect").change(loadShifts);

        // Optional: load on page load if user already selected
        $(document).ready(function () {
            if ($("#userSelect").val()) {
                loadShifts();
            }
        });

    </script>
}
