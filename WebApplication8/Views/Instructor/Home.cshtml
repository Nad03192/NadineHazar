@{
    ViewData["Title"] = "Instructor Home";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<h2 class="mb-4">Instructor Dashboard</h2>

<div class="d-flex flex-wrap gap-4">

    <a asp-controller="Availabilities" asp-action="EnterWeeklyAvailability" class="dashboard-box text-decoration-none">
        <i class="fas fa-calendar-check fa-2x mb-2"></i>
        <div>Enter Availability</div>
    </a>


    <a asp-area="Instructor" asp-controller="Schedule" asp-action="Index" class="dashboard-box text-decoration-none">
        <i class="fas fa-calendar-alt fa-2x mb-2"></i>
        <div>My Schedule</div>
    </a>

    <a asp-area="Instructor" asp-controller="Courses" asp-action="MyCourses" class="dashboard-box text-decoration-none">
        <i class="fas fa-book-reader fa-2x mb-2"></i>
        <div>My Classes</div>
    </a>

</div>

<style>
    .dashboard-box {
        width: 180px;
        height: 150px;
        background-color: #f8f9fa;
        border: 1px solid #ddd;
        border-radius: 12px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.05);
        color: #333;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .dashboard-box:hover {
            transform: translateY(-5px);
            box-shadow: 4px 4px 15px rgba(0, 0, 0, 0.1);
            background-color: #e2e6ea;
        }

        .dashboard-box i {
            color: #0d6efd;
        }
</style>
