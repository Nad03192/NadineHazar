@model List<WebApplication8.Models.MyClassViewModel>

<h1>My Classes - Current Semester</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You are not enrolled in any classes for the current semester.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Course Name</th>
                <th>Course Type</th>
                <th>Instructor</th>
                <th>Day & Time</th>
                <th>Room</th>
                <th>Credits</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cls in Model)
            {
                <tr>
                    <td>@cls.CourseName</td>
                    <td>@cls.CourseTypeName</td>
                    <td>@cls.InstructorUserName</td>
                    <td>@cls.DayOfWeek @cls.StartTime</td>
                    <td>@cls.RoomName (@cls.BuildingName)</td>
                    <td>@cls.CreditNumber</td>

                </tr>
            }
        </tbody>
    </table>
}
