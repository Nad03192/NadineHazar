@model IEnumerable<WebApplication8.Models.Building>

@{
    ViewData["Title"] = "Buildings";
    var currentSearch = ViewBag.CurrentFilter as string;
    var campusList = ViewBag.CampusId as SelectList;
    var selectedCampus = ViewBag.SelectedCampus as string;
}

<h1>Buildings</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<!-- Search + Campus Filter -->
<form asp-action="Index" method="get" class="form-inline mb-3">
    <input type="text" name="searchString" value="@currentSearch" class="form-control mr-2" placeholder="Search by Name or Description..." />

    <select name="campusId" asp-items="campusList" class="form-control mr-2">
        <option value="">-- All Campuses --</option>
    </select>


    <button type="submit" class="btn btn-outline-primary">Filter</button>
    <a asp-action="Index" class="btn btn-outline-secondary ml-2">Clear</a>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>@Html.DisplayNameFor(model => model.Campus)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>@item.Campus.Name</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.BuildingId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.BuildingId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.BuildingId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
