@model WebApplication8.Models.UserViewModel

@{
    ViewData["Title"] = "Delete Student";
}

<h2 class="mb-4 text-center">Delete Student</h2>

<div class="card shadow-sm p-4 mx-auto" style="max-width: 500px;">
    <h5>Are you sure you want to delete this student?</h5>
    <dl class="row mt-3">
        <dt class="col-sm-4">Username</dt>
        <dd class="col-sm-8">@Model.UserName</dd>

        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@Model.Email</dd>

        <dt class="col-sm-4">Phone</dt>
        <dd class="col-sm-8">@Model.PhoneNumber</dd>
    </dl>

    <form asp-action="DeleteStudent" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Students" class="btn btn-secondary">Cancel</a>
    </form>
</div>
