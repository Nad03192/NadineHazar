@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

@{
    ViewData["Title"] = "Students";
}

<h2 class="mb-4">Students</h2>

<p>
    <a asp-action="CreateStudent" class="btn btn-success">Create New Student</a>
</p>

<!-- Search Form -->
<form method="get" class="mb-3 row g-2">
    <div class="col-auto">
        <input type="text" name="search" class="form-control"
               placeholder="Search by Email, Username or Phone"
               value="@ViewBag.Search" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Email</th>
            <th>Username</th>
            <th>Phone Number</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Email</td>
                <td>@student.UserName</td>
                <td>@student.PhoneNumber</td>
                <td>
                    <a asp-action="EditStudent" asp-route-id="@student.Id" class="btn btn-sm btn-primary">Edit</a>
             
                    <a asp-action="DeleteStudent" asp-route-id="@student.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
