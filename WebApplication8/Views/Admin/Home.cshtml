@{
    ViewData["Title"] = "Admin Home";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<h2 class="mb-4">Admin Dashboard</h2>

<div class="dashboard-section">
    <h4>📚 Academic Structure</h4>
    <div class="d-flex flex-wrap gap-4">
        <a asp-action="Index" asp-controller="Faculties" class="dashboard-box text-decoration-none">
            <i class="fas fa-university fa-2x mb-2"></i>
            <div>Faculties</div>
        </a>
        <a asp-action="Index" asp-controller="Rooms" class="dashboard-box text-decoration-none">
            <i class="fas fa-door-open fa-2x mb-2"></i>
            <div>Rooms</div>
        </a>
        <a asp-action="Index" asp-controller="StudyPrograms" class="dashboard-box text-decoration-none">
            <i class="fas fa-project-diagram fa-2x mb-2"></i>
            <div>Study Programs</div>
        </a>
        <a asp-action="Index" asp-controller="Campus" class="dashboard-box text-decoration-none">
            <i class="fas fa-map-marked-alt fa-2x mb-2"></i>
            <div>Campuses</div>
        </a>
        <a asp-action="Index" asp-controller="Buildings" class="dashboard-box text-decoration-none">
            <i class="fas fa-building fa-2x mb-2"></i>
            <div>Buildings</div>
        </a>
        <a asp-action="Index" asp-controller="UserCampus" class="dashboard-box text-decoration-none">
            <i class="fas fa-users fa-2x mb-2"></i>
            <div>User Campuses</div>
        </a>
    </div>
</div>

<div class="dashboard-section">
    <h4>👩‍🏫 Staff Management</h4>
    <div class="d-flex flex-wrap gap-4">
        <a asp-action="Instructors" asp-controller="Admin" class="dashboard-box text-decoration-none">
            <i class="fas fa-chalkboard-teacher fa-2x mb-2"></i>
            <div>Instructors</div>
        </a>
        <a asp-action="Index" asp-controller="ProgramManagers" class="dashboard-box text-decoration-none">
            <i class="fas fa-user-tie fa-2x mb-2"></i>
            <div>Program Managers</div>
        </a>
        <a asp-action="Index" asp-controller="InstructorCourses" class="dashboard-box text-decoration-none">
            <i class="fas fa-user-cog fa-2x mb-2"></i>
            <div>Instructor Courses</div>
        </a>
        <a asp-action="Index" asp-controller="Availabilities" class="dashboard-box text-decoration-none">
            <i class="fas fa-calendar-check fa-2x mb-2"></i>
            <div>Availabilities</div>
        </a>
        <a asp-action="Index" asp-controller="LoadedTimes" class="dashboard-box text-decoration-none">
            <i class="fas fa-clock fa-2x mb-2"></i>
            <div>Loaded Times</div>
        </a>
        <a asp-action="Index" asp-controller="Shifts" class="dashboard-box text-decoration-none">
            <i class="fas fa-business-time fa-2x mb-2"></i>
            <div>Shifts</div>
        </a>
    </div>
</div>

<div class="dashboard-section">
    <h4>📘 Course & Curriculum</h4>
    <div class="d-flex flex-wrap gap-4">
        <a asp-action="Index" asp-controller="Courses" class="dashboard-box text-decoration-none">
            <i class="fas fa-book fa-2x mb-2"></i>
            <div>Courses</div>
        </a>
        <a asp-action="Index" asp-controller="CoursePrerequisites" class="dashboard-box text-decoration-none">
            <i class="fas fa-link fa-2x mb-2"></i>
            <div>Course Prerequisites</div>
        </a>
        <a asp-action="Index" asp-controller="CourseTypes" class="dashboard-box text-decoration-none">
            <i class="fas fa-tags fa-2x mb-2"></i>
            <div>Course Types</div>
        </a>
        <a asp-action="Index" asp-controller="ProgramCourses" class="dashboard-box text-decoration-none">
            <i class="fas fa-project-diagram fa-2x mb-2"></i>
            <div>Program Courses</div>
        </a>
        <a asp-action="Index" asp-controller="GradeDefinitions" class="dashboard-box text-decoration-none">
            <i class="fas fa-clipboard-list fa-2x mb-2"></i>
            <div>Grade Definitions</div>
        </a>
        <a asp-action="Index" asp-controller="Classes" class="dashboard-box text-decoration-none">
            <i class="fas fa-school fa-2x mb-2"></i>
            <div>Classes</div>
        </a>
        <a asp-action="Index" asp-controller="Semesters" class="dashboard-box text-decoration-none">
            <i class="fas fa-calendar-alt fa-2x mb-2"></i>
            <div>Semesters</div>
        </a>
    </div>
</div>

<div class="dashboard-section">
    <h4>🎓 Student Management</h4>
    <div class="d-flex flex-wrap gap-4">
        <a asp-action="Students" asp-controller="Admin" class="dashboard-box text-decoration-none">
            <i class="fas fa-user-graduate fa-2x mb-2"></i>
            <div>Students</div>
        </a>
        <a asp-action="Index" asp-controller="UserPrograms" class="dashboard-box text-decoration-none">
            <i class="fas fa-users fa-2x mb-2"></i>
            <div>User Programs</div>
        </a>
        <a asp-action="Index" asp-controller="StudentGrades" class="dashboard-box text-decoration-none">
            <i class="fas fa-graduation-cap fa-2x mb-2"></i>
            <div>Student Grades</div>
        </a>
        <a asp-action="Index" asp-controller="Enrollments" class="dashboard-box text-decoration-none">
            <i class="fas fa-user-plus fa-2x mb-2"></i>
            <div>Enrollments</div>
        </a>
    </div>
</div>

<style>
    .dashboard-section {
        margin-bottom: 2rem;
    }

        .dashboard-section h4 {
            margin-bottom: 1rem;
            color: #0d6efd;
            font-weight: 600;
        }

    .dashboard-box {
        width: 180px;
        height: 150px;
        background-color: #f8f9fa;
        border: 1px solid #ddd;
        border-radius: 12px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.05);
        color: #333;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        transition: transform 0.2s, box-shadow 0.2s;
        flex: 1 1 180px;
    }

        .dashboard-box:hover {
            transform: translateY(-5px);
            box-shadow: 4px 4px 15px rgba(0, 0, 0, 0.1);
            background-color: #e2e6ea;
        }

        .dashboard-box i {
            color: #0d6efd;
        }
         @@media (max-width: 768px) {
        .dashboard-box

    {
        width: 100%;
        height: auto;
        padding: 1rem;
    }

    .d-flex.flex-wrap.gap-4 {
        gap: 1rem;
    }

    }


    .d-flex.flex-wrap.gap-4 {
        gap: 1rem;
    }

    }

    .d-flex.flex-wrap.gap-4 {
        gap: 1rem;
    }

    }
</style>

