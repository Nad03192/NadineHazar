@model IEnumerable<WebApplication8.Models.Shift>

@{
    ViewData["Title"] = "Index";
}

<h1>Shifts</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["StartTimeSortParm"]">Start Time</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["EndTimeSortParm"]">End Time</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.StartTime)</td>
                <td>@Html.DisplayFor(modelItem => item.EndTime)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ShiftId">Edit</a> |
                  
                    <a asp-action="Delete" asp-route-id="@item.ShiftId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
