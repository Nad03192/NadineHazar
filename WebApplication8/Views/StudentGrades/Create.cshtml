@model WebApplication8.Models.StudentGrade

@{
    ViewData["Title"] = "Create Student Grade";
}

<h1>Create Student Grade</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="EnrollmentId" class="control-label"></label>
                <select asp-for="EnrollmentId" class="form-control" asp-items="ViewBag.EnrollmentId"></select>
                <span asp-validation-for="EnrollmentId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GradeDefinitionId" class="control-label"></label>
                <select asp-for="GradeDefinitionId" class="form-control" asp-items="ViewBag.GradeDefinitionId"></select>
                <span asp-validation-for="GradeDefinitionId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Score" class="control-label"></label>
                <input asp-for="Score" class="form-control" />
                <span asp-validation-for="Score" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>

    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById("EnrollmentId").addEventListener("change", function () {
            var enrollmentId = this.value;
            var gradeSelect = document.getElementById("GradeDefinitionId");

            if (!enrollmentId) {
                gradeSelect.innerHTML = '<option value="">-- Select Grade Definition --</option>';
                return;
            }

            fetch(`/StudentGrades/GetGradeDefinitions?enrollmentId=${enrollmentId}`)
                .then(response => response.json())
                .then(data => {
                    gradeSelect.innerHTML = '<option value="">-- Select Grade Definition --</option>';
                    data.forEach(g => {
                        var opt = document.createElement("option");
                        opt.value = g.id;
                        opt.text = g.name;
                        gradeSelect.add(opt);
                    });
                })
                .catch(err => console.error(err));
        });
    </script>
}
