@model IEnumerable<WebApplication8.Models.Course>

@{
    ViewData["Title"] = "Index";
}

<h1>Courses</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<form method="get" class="mb-3 row g-2">
    <div class="col-auto">
        <input type="text" name="searchName" class="form-control" placeholder="Search by course name"
               value="@(ViewBag.SearchName ?? "")" />
    </div>

    <div class="col-auto">
        <input type="text" name="searchDescription" class="form-control" placeholder="Search by description"
               value="@(ViewBag.SearchDescription ?? "")" />
    </div>

    <div class="col-auto">
        <select name="studyProgramId" class="form-control" asp-items="ViewBag.StudyPrograms">
            <option value="">-- All Study Programs --</option>
        </select>
    </div>

    <div class="col-auto">
        <select name="courseTypeId" class="form-control" asp-items="ViewBag.CourseTypes">
            <option value="">-- All Course Types --</option>
        </select>
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
</form>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreditNumber)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreditNumber)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CourseId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CourseId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CourseId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
