@model IEnumerable<WebApplication8.Models.GradeDefinition>

@{
    ViewData["Title"] = "Index";
}

<h1>Grade Definitions</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<form method="get" class="mb-3 row g-2">
    <div class="col-auto">
        <input type="text" name="searchCourse" class="form-control"
               placeholder="Search by course name" value="@(ViewBag.SearchCourse ?? "")" />
    </div>

    <div class="col-auto">
        <select name="studyProgramId" class="form-control" asp-items="ViewBag.StudyPrograms">
            <option value="">-- All Study Programs --</option>
        </select>
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Course)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Coefficient)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            <tr>
                <td>@item.Course?.Name</td>
                <td>@item.Name</td>
                <td>@item.Coefficient</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                  
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
}
    </tbody>
</table>
