@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card shadow-lg border-0 rounded-4" style="width: 420px;">
        <div class="card-header text-center bg-primary text-white rounded-top-4">
            <h2 class="my-2">Welcome Back</h2>
            <p class="mb-0">Please log in to your account</p>
        </div>

        <div class="card-body p-4">
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="current-password" placeholder="Password" type="password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label"></label>
                    </div>
                    <a id="forgot-password" asp-page="./ForgotPassword" class="text-primary">Forgot password?</a>
                </div>

                <button id="login-submit" type="submit" class="btn btn-primary w-100 rounded-3 py-2 fw-bold">
                    Log In
                </button>

                <hr class="my-4" />

            </form>
        </div>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="card-footer text-center bg-white border-0">
                <p class="mb-2">Or log in with</p>
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-primary rounded-3 mx-1" name="provider" value="@provider.Name">
                            @provider.DisplayName
                        </button>
                    </form>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
